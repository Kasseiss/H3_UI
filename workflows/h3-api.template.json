{
  "1": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "{{UNET_MODEL}}",
      "weight_dtype": "default"
    },
    "_meta": { "title": "MiniMax H3 Model" }
  },
  "2": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "{{CLIP_MODEL}}",
      "type": "minimax",
      "device": "default"
    },
    "_meta": { "title": "MiniMax H3 Text Encoder" }
  },
  "3": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "{{VIDEO_VAE}}" },
    "_meta": { "title": "MiniMax H3 Video VAE" }
  },
  "4": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "{{AUDIO_VAE}}" },
    "_meta": { "title": "MiniMax H3 Audio VAE" }
  },
  "5": {
    "class_type": "MiniMaxH3ReferenceToVideo",
    "inputs": {
      "clip": ["2", 0],
      "vae": ["3", 0],
      "audio_vae": ["4", 0],
      "prompt": "{{PROMPT}}",
      "width": "{{WIDTH}}",
      "height": "{{HEIGHT}}",
      "length": "{{FRAMES}}",
      "ref_image_size": "match",
      "ref_images.ref_image_0": ["20", 0],
      "ref_images.ref_image_1": ["21", 0],
      "ref_images.ref_image_2": ["22", 0],
      "ref_images.ref_image_3": ["23", 0],
      "ref_images.ref_image_4": ["24", 0],
      "ref_images.ref_image_5": ["25", 0],
      "ref_images.ref_image_6": ["26", 0],
      "ref_images.ref_image_7": ["27", 0],
      "ref_images.ref_image_8": ["28", 0],
      "ref_videos.ref_video_0": ["31", 0],
      "ref_video_audios.ref_video_audio_0": ["31", 1],
      "ref_videos.ref_video_1": ["33", 0],
      "ref_video_audios.ref_video_audio_1": ["33", 1],
      "ref_videos.ref_video_2": ["35", 0],
      "ref_video_audios.ref_video_audio_2": ["35", 1],
      "ref_audios.ref_audio_0": ["40", 0],
      "ref_audios.ref_audio_1": ["41", 0],
      "ref_audios.ref_audio_2": ["42", 0]
    },
    "_meta": { "title": "MiniMax H3 Reference to Video" }
  },
  "6": {
    "class_type": "KSamplerSelect",
    "inputs": { "sampler_name": "res_multistep" },
    "_meta": { "title": "Sampler" }
  },
  "7": {
    "class_type": "BasicScheduler",
    "inputs": {
      "model": ["1", 0],
      "scheduler": "simple",
      "steps": 20,
      "denoise": 1
    },
    "_meta": { "title": "Scheduler" }
  },
  "8": {
    "class_type": "RandomNoise",
    "inputs": { "noise_seed": "{{SEED}}" },
    "_meta": { "title": "Seed" }
  },
  "9": {
    "class_type": "BasicGuider",
    "inputs": {
      "model": ["1", 0],
      "conditioning": ["5", 0]
    },
    "_meta": { "title": "Guider" }
  },
  "10": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": ["8", 0],
      "guider": ["9", 0],
      "sampler": ["6", 0],
      "sigmas": ["7", 0],
      "latent_image": ["5", 1]
    },
    "_meta": { "title": "Sample H3" }
  },
  "11": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["10", 0],
      "vae": ["3", 0]
    },
    "_meta": { "title": "Decode Video" }
  },
  "12": {
    "class_type": "VAEDecodeAudio",
    "inputs": {
      "samples": ["10", 0],
      "vae": ["4", 0]
    },
    "_meta": { "title": "Decode Audio" }
  },
  "13": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": ["11", 0],
      "audio": ["12", 0],
      "fps": 24,
      "bit_depth": 8
    },
    "_meta": { "title": "Create Video" }
  },
  "14": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": ["13", 0],
      "filename_prefix": "H3Studio/%date:yyyy-MM-dd%/H3",
      "format": "auto",
      "codec": "auto"
    },
    "_meta": { "title": "Save Video" }
  },
  "20": { "class_type": "LoadImage", "inputs": { "image": "{{IMAGE_1}}" }, "_meta": { "title": "Reference Image 1" } },
  "21": { "class_type": "LoadImage", "inputs": { "image": "{{IMAGE_2}}" }, "_meta": { "title": "Reference Image 2" } },
  "22": { "class_type": "LoadImage", "inputs": { "image": "{{IMAGE_3}}" }, "_meta": { "title": "Reference Image 3" } },
  "23": { "class_type": "LoadImage", "inputs": { "image": "{{IMAGE_4}}" }, "_meta": { "title": "Reference Image 4" } },
  "24": { "class_type": "LoadImage", "inputs": { "image": "{{IMAGE_5}}" }, "_meta": { "title": "Reference Image 5" } },
  "25": { "class_type": "LoadImage", "inputs": { "image": "{{IMAGE_6}}" }, "_meta": { "title": "Reference Image 6" } },
  "26": { "class_type": "LoadImage", "inputs": { "image": "{{IMAGE_7}}" }, "_meta": { "title": "Reference Image 7" } },
  "27": { "class_type": "LoadImage", "inputs": { "image": "{{IMAGE_8}}" }, "_meta": { "title": "Reference Image 8" } },
  "28": { "class_type": "LoadImage", "inputs": { "image": "{{IMAGE_9}}" }, "_meta": { "title": "Reference Image 9" } },
  "30": { "class_type": "LoadVideo", "inputs": { "file": "{{VIDEO_1}}" }, "_meta": { "title": "Reference Video 1" } },
  "31": { "class_type": "GetVideoComponents", "inputs": { "video": ["30", 0] }, "_meta": { "title": "Reference Video Components 1" } },
  "32": { "class_type": "LoadVideo", "inputs": { "file": "{{VIDEO_2}}" }, "_meta": { "title": "Reference Video 2" } },
  "33": { "class_type": "GetVideoComponents", "inputs": { "video": ["32", 0] }, "_meta": { "title": "Reference Video Components 2" } },
  "34": { "class_type": "LoadVideo", "inputs": { "file": "{{VIDEO_3}}" }, "_meta": { "title": "Reference Video 3" } },
  "35": { "class_type": "GetVideoComponents", "inputs": { "video": ["34", 0] }, "_meta": { "title": "Reference Video Components 3" } },
  "40": { "class_type": "LoadAudio", "inputs": { "audio": "{{AUDIO_1}}" }, "_meta": { "title": "Reference Audio 1" } },
  "41": { "class_type": "LoadAudio", "inputs": { "audio": "{{AUDIO_2}}" }, "_meta": { "title": "Reference Audio 2" } },
  "42": { "class_type": "LoadAudio", "inputs": { "audio": "{{AUDIO_3}}" }, "_meta": { "title": "Reference Audio 3" } }
}
